/* Question 6 */

/*
Part A
------
Actions of Interest:
	1) enter - A gang enters the court.
	2) play - A gang plays basketball on the court.
	3) leave - A gang leaves the court.
	4) tie - A gang ties a red handkerchief to signal they are entering the court.
	5) see - A gang checks the other gang's handkerchief for a red tie.
	6) untie - A gang unties its own red handkerchief if it cannot enter or after leaving the court.
New Actions:
	7) setTurn - A gang sets the turn indicator to the other gang.
	8) checkTurn - A gang checks the turn indicator for the next gang that can enter the court.
	9) wait - A gang waits if the turn is not theirs and the other handkerchief is red.
Processes Involved:
	1) GANG - Represents the behaviour of both the Sharks and the Jets.
	2) COURT - Represents the court as a shared resource.
	3) HANDKERCHIEFS - Represents the collective handkerchief status at the court.
New Processes:
	4) INDICATOR - Represents the turn indicator as a shared resource, showing which can can play next.
*/

/*
Part B
------
Structural diagram provided in PDF file.
*/

/* Part C */

// Property enforcing mutual exclusion
property MUTEX = (sharks.court.go -> sharks.court.leave -> MUTEX
	| jets.court.go -> jets.court.leave -> MUTEX).

// Users of the court
GANG(US='us, OTHERS='others) = BEGIN,
	BEGIN = (tie -> SET_OR_CHECK),
	SET_OR_CHECK = (setTurn[OTHERS] -> CHECK
		| checkTurn[OTHERS] -> wait -> SET_OR_CHECK),
	CHECK = (checkTurn[US] -> TURN_US
		| checkTurn[OTHERS] -> TURN_OTHERS),
	TURN_US = (see.white -> ENTER
		| see.red -> DONE),
	TURN_OTHERS = (see.white -> ENTER
		| see.red -> WAIT),
	ENTER = (court.go -> play -> court.leave -> DONE),
	WAIT = (wait -> CHECK),
	DONE = (untie -> BEGIN).

// Court as a shared resource
COURT = (go -> leave -> COURT).

// Handkerchiefs as signals
HANDKERCHIEFS = NONE,
	NONE = (tie -> ONE),
	ONE = (tie -> BOTH | see.white -> ONE | untie -> NONE),
	BOTH = (see.red -> BOTH | untie -> ONE).

set Gangs = {sharks, jets}

// Turn indicator for fairness
INDICATOR = NONE,
	NONE = (jets.setTurn['sharks] -> TURN_S | sharks.setTurn['jets] -> TURN_J),
	TURN_J = (jets.setTurn['sharks] -> TURN_S | Gangs.checkTurn['jets] -> TURN_J),
	TURN_S = (sharks.setTurn['jets] -> TURN_J | Gangs.checkTurn['sharks] -> TURN_S).

// System composition
||COURT_SHARE = (sharks:GANG('sharks,'jets)
	|| jets:GANG('jets,'sharks)
	|| Gangs::court:COURT
	|| Gangs::HANDKERCHIEFS
	|| INDICATOR).

/* Part D */

// Property (Q3) satisfaction check
||CHECK = (COURT_SHARE || MUTEX).

/* Part E */

// Progress check (Q5) - Assumption that the gangs are fair
progress SHARKS_FAIR = {sharks.court.go, sharks.untie}
progress JETS_FAIR = {jets.court.go, sharks.untie}

// Progress check (Q5) - Assumption that the gangs are greedy
progress SHARKS_GREEDY = {sharks.tie, sharks.court.go}
progress JETS_GREEDY = {jets.tie, jets.court.go}
