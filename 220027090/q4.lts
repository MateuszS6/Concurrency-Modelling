/* Question 4 */

/*
Part A
------
Actions of Interest:
	1) enter - A gang enters the court.
	2) play - A gang plays basketball on the court.
	3) leave - A gang leaves the court.
New actions:
	4) tie - A gang ties a red handkerchief to signal they are entering the court.
	5) see - A gang checks the other gang's handkerchief for a red tie.
	6) untie - A gang unties its own red handkerchief if it cannot enter or after leaving the court.
Processes Involved:
	1) GANG - Represents the behaviour of both the Sharks and the Jets.
	2) COURT - Represents the court as a shared resource.
New processes:
	3) HANDKERCHIEF - Represents the collective handkerchief status at the court.
*/

/*
Part B
------
Structural diagram provided in PDF file.
*/

/* Part C */

// Property enforcing mutual exclusion
property MUTEX = (sharks.court.go -> sharks.court.leave -> MUTEX
	| jets.court.go -> jets.court.leave -> MUTEX).

// Users of the court
GANG = (tie -> CHECKING),
	CHECKING = (see.white -> READY | see.red -> DONE),
	READY = (court.go -> play -> court.leave -> DONE),
	DONE = (untie -> GANG).

// Court as a shared resource
COURT = (go -> leave -> COURT).

// Handkerchiefs as signals
HANDKERCHIEFS = BOTH,
	BOTH = (tie -> ONE | see.red -> BOTH | untie -> ONE),
	ONE = (tie -> BOTH | see.white -> ONE | untie -> BOTH).

set Gangs = {sharks, jets}

// System composition
||COURT_SHARE = (Gangs:GANG || Gangs::court:COURT || Gangs::HANDKERCHIEFS).

||CHECK = (COURT_SHARE || MUTEX).
