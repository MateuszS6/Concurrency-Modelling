/* Question 3 */

/*
Part A
------
Actions of Interest:
	1) enter - A gang enters the court.
	2) play - A gang plays basketball on the court.
	3) leave - A gang leaves the court.
Processes Involved:
	1) GANG - Represents the behaviour of both the Sharks and the Jets.
	2) COURT - Represents the court as a shared resource.
*/

/* Part B */

// Property enforcing mutual exclusion
property MUTEX = (sharks.court.go -> sharks.court.leave -> MUTEX
	| jets.court.go -> jets.court.leave -> MUTEX).

/*
Part C
------
Structural diagram provided in PDF file.
*/

/* Part D */

// Users of the court
GANG = (court.go -> play -> court.leave -> GANG).

// Court as a shared resource
COURT = (go -> leave -> COURT).

set Gangs = {sharks, jets}

// System composition
||COURT_SHARE = (Gangs:GANG || Gangs::court:COURT || MUTEX).

